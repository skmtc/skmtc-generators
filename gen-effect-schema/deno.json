{
  "name": "@skmtc/gen-effect-schema",
  "version": "0.1.8",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:typecheck": "TYPECHECK=1 deno test --allow-env --allow-sys --allow-read --allow-write --allow-run=deno --allow-net test/typecheck.test.ts",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov --include='/gen-effect-schema/'",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "imports": {
    "@skmtc/core": "jsr:@skmtc/core@0.40.0",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.13.0",
    "@skmtc/gen-typescript": "jsr:@skmtc/gen-typescript@0.2.17",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "ts-pattern": "npm:ts-pattern@^5.9.0",
    "valibot": "npm:valibot@1.1.0"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "test/",
      "deno.lock",
      "**/CLAUDE.md",
      "coverage/"
    ]
  }
}
