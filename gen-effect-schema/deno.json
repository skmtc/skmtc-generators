{
  "name": "@skmtc/gen-effect-schema",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "imports": {
    "@skmtc/core": "jsr:@skmtc/core@0.29.0",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.12.24",
    "@skmtc/gen-typescript": "jsr:@skmtc/gen-typescript@0.2.9",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.2",
    "ts-pattern": "npm:ts-pattern@^5.9.0",
    "valibot": "npm:valibot@1.1.0"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "test/",
      "deno.lock",
      "**/CLAUDE.md",
      "coverage/"
    ]
  }
}
