{
  "name": "@skmtc/gen-md-docs",
  "version": "0.1.4",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:update": "UPDATE_GOLDEN=1 deno test --allow-env --allow-sys --allow-read --allow-write",
    "test:live": "LIVE=1 deno test --allow-env --allow-sys --allow-read --allow-net",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "imports": {
    "@/": "./",
    "@skmtc/core": "jsr:@skmtc/core@0.30.1",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.12.26",
    "openapi-types": "npm:openapi-types@^12.1.3",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/log": "jsr:@std/log@^0.224.6",
    "@std/yaml": "jsr:@std/yaml@^1.0.0"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types",
        "skmtc/single-dispatch"
      ]
    }
  }
}
