{
  "name": "@skmtc/gen-zod",
  "version": "0.4.5",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:typecheck": "TYPECHECK=1 deno test --allow-env --allow-sys --allow-read --allow-write --allow-run=deno --allow-net test/typecheck.test.ts",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov --include='/gen-zod/'",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "imports": {
    "@skmtc/core": "jsr:@skmtc/core@0.44.1",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.14.5",
    "@skmtc/gen-typescript": "jsr:@skmtc/gen-typescript@0.2.20",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/log": "jsr:@std/log@^0.224.6"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
