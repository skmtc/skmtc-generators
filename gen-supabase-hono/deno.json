{
  "name": "@skmtc/gen-supabase-hono",
  "version": "0.2.23",
  "exports": "./mod.ts",
  "imports": {
    "@skmtc/gen-zod": "jsr:@skmtc/gen-zod@0.4.6",
    "@skmtc/gen-typescript": "jsr:@skmtc/gen-typescript@0.2.21",
    "@skmtc/core": "jsr:@skmtc/core@0.44.2",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.14.6"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov --include='/gen-supabase-hono/'",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
