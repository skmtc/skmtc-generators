{
  "name": "@skmtc/gen-effect-http",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "imports": {
    "@skmtc/core": "jsr:@skmtc/core@0.29.0",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.12.24",
    "@skmtc/gen-effect-schema": "jsr:@skmtc/gen-effect-schema@0.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.10"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "test/",
      "deno.lock",
      "**/CLAUDE.md",
      "coverage/"
    ]
  }
}
