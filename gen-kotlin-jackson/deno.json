{
  "name": "@skmtc/gen-kotlin-jackson",
  "version": "0.1.11",
  "exports": "./mod.ts",
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "private": true,
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov --include='/gen-kotlin-jackson/'",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed"
  },
  "imports": {
    "@skmtc/core": "jsr:@skmtc/core@0.48.0",
    "@skmtc/lang-kotlin": "jsr:@skmtc/lang-kotlin@0.11.36",
    "valibot": "npm:valibot@1.5.0",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/log": "jsr:@std/log@^0.224.6"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
