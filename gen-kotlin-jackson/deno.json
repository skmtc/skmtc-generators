{
  "name": "@skmtc/gen-kotlin-jackson",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "private": true,
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed"
  },
  "imports": {
    "@skmtc/core": "jsr:@skmtc/core@0.28.3",
    "@skmtc/lang-kotlin": "jsr:@skmtc/lang-kotlin@0.10.0",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.9",
    "ts-pattern": "npm:ts-pattern@^5.9.0"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
