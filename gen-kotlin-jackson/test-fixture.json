{
  "openapi": "3.0.3",
  "info": {
    "title": "Orders API (task1k: Kotlin+Jackson model fixture)",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "items",
          "shipping_address"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "shipping_address": {
            "$ref": "#/components/schemas/Address"
          },
          "billing_address": {
            "$ref": "#/components/schemas/Address"
          },
          "customer_notes": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "campaign_id": {
                "type": "string"
              }
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ]
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentMethod"
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": [
          "sku",
          "quantity",
          "unit_price"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unit_price": {
            "type": "number"
          },
          "gift_wrap": {
            "type": "boolean"
          }
        }
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "paid",
          "shipped",
          "cancelled"
        ]
      },
      "Address": {
        "type": "object",
        "required": [
          "line_1",
          "city",
          "postal_code",
          "country"
        ],
        "properties": {
          "line_1": {
            "type": "string"
          },
          "line_2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "PaymentMethod": {
        "description": "How the order is paid for.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/CardPayment"
          },
          {
            "$ref": "#/components/schemas/BankTransferPayment"
          },
          {
            "$ref": "#/components/schemas/StoreCreditPayment"
          }
        ],
        "discriminator": {
          "propertyName": "method",
          "mapping": {
            "card": "#/components/schemas/CardPayment",
            "bank_transfer": "#/components/schemas/BankTransferPayment"
          }
        }
      },
      "CardPayment": {
        "type": "object",
        "required": [
          "method",
          "last_four"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "last_four": {
            "type": "string"
          },
          "expiry_month": {
            "type": "integer"
          }
        }
      },
      "BankTransferPayment": {
        "type": "object",
        "required": [
          "method",
          "iban"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "iban": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "StoreCreditPayment": {
        "type": "object",
        "required": [
          "method",
          "balance_used"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "balance_used": {
            "type": "number"
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "theme"
        ],
        "properties": {
          "theme": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "string"
        },
        "description": "Arbitrary client settings."
      },
      "LegacyValue": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ]
      },
      "Widget": {
        "type": "object",
        "required": [
          "properties"
        ],
        "properties": {
          "properties": {
            "type": "object",
            "required": [
              "color"
            ],
            "properties": {
              "color": {
                "type": "string"
              }
            }
          },
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              }
            }
          },
          "schema": {
            "type": "string"
          }
        }
      }
    }
  }
}
