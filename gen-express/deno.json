{
  "name": "@skmtc/gen-express",
  "version": "0.2.33",
  "exports": "./mod.ts",
  "imports": {
    "@skmtc/gen-valibot": "jsr:@skmtc/gen-valibot@0.3.5",
    "@skmtc/gen-typescript": "jsr:@skmtc/gen-typescript@0.2.32",
    "@skmtc/core": "jsr:@skmtc/core@0.58.1",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.15.18"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov --include='/gen-express/'",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "test/",
      "deno.lock",
      "**/CLAUDE.md",
      "coverage/",
      "coverage.lcov"
    ]
  }
}
