{
  "name": "@skmtc/gen-kotlin-spring",
  "version": "0.5.0",
  "exports": "./mod.ts",
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "private": true,
  "imports": {
    "@skmtc/core": "jsr:@skmtc/core@0.28.3",
    "@skmtc/lang-kotlin": "jsr:@skmtc/lang-kotlin@0.9.14",
    "@skmtc/gen-kotlin-jackson": "../gen-kotlin-jackson/mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.9",
    "ts-pattern": "npm:ts-pattern@^5.9.0"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read"
  }
}
