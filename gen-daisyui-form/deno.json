{
  "name": "@skmtc/gen-daisyui-form",
  "version": "0.3.2",
  "imports": {
    "@skmtc/gen-typescript": "jsr:@skmtc/gen-typescript@0.2.7",
    "@skmtc/gen-zod": "jsr:@skmtc/gen-zod@0.2.7",
    "@skmtc/core": "jsr:@skmtc/core@0.29.0",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.12.22"
  },
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed",
    "publish": "JSR_URL=https://jsr.skmtc.co.uk/ deno publish --allow-slow-types --allow-dirty --token=$JSR_AUTH_TOKEN"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ]
  }
}
