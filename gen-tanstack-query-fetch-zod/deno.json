{
  "name": "@skmtc/gen-tanstack-query-fetch-zod",
  "version": "0.2.17",
  "exports": "./mod.ts",
  "imports": {
    "@skmtc/gen-zod": "jsr:@skmtc/gen-zod@0.3.1",
    "@skmtc/gen-typescript": "jsr:@skmtc/gen-typescript@0.2.16",
    "@skmtc/core": "jsr:@skmtc/core@0.40.0",
    "@skmtc/lang-typescript": "jsr:@skmtc/lang-typescript@0.13.0",
    "@babel/helper-validator-identifier": "npm:@babel/helper-validator-identifier@7.22.20",
    "@types/babel__helper-validator-identifier": "npm:@types/babel__helper-validator-identifier@7.15.2"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-sys --allow-read",
    "test:coverage": "deno test --allow-env --allow-sys --allow-read --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage.lcov",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno coverage coverage --detailed",
    "publish": "deno publish --allow-slow-types --allow-dirty"
  },
  "lint": {
    "plugins": [
      "jsr:@skmtc/lint-plugin@0.1.0"
    ],
    "rules": {
      "exclude": [
        "no-slow-types",
        "skmtc/single-dispatch"
      ]
    }
  }
}
